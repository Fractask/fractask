{
  "name": "@getshit/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    },
    "./agent-templates": {
      "types": "./dist/agent-templates.d.ts",
      "import": "./dist/agent-templates.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/smoke.test.ts src/recurrence.test.ts src/recurrence-cron.test.ts src/tasks.test.ts src/mcp-tools.test.ts src/focus.test.ts src/prompt-guards.test.ts src/pass-on.test.ts src/scratchpad.test.ts src/mcp-errors.test.ts src/not-shared-deploy-marker.test.ts src/not-shared-behaviour-probe.test.ts",
    "not-shared-marker": "tsx scripts/not-shared-deploy-marker.mts",
    "not-shared-behaviour": "tsx scripts/not-shared-behaviour-probe.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.41.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.0.9",
    "openai": "^4.77.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
